# ===== KanZen : configuration =====
# Tout secret XXX peut aussi être lu depuis un fichier via XXX_FILE (ex. LDAP_BIND_PASSWORD_FILE).

# --- Serveur ---
NODE_ENV=production
HOST=127.0.0.1                 # écoute locale, exposition par le reverse proxy
PORT=3000
PUBLIC_URL=https://kanzen.corp.local   # URL vue par les navigateurs (contrôle d'Origin)
TRUST_PROXY=127.0.0.1          # IP du reverse proxy (X-Forwarded-For)
STATIC_DIR=/opt/kanzen/public  # build de l'interface
LOG_LEVEL=info

# --- Base de données ---
DATABASE_URL=postgresql://kanzen:CHANGER_MOI@127.0.0.1:5432/kanzen?schema=public

# --- Sessions ---
SESSION_TTL_HOURS=8            # durée maximale d'une session
SESSION_IDLE_MINUTES=60        # expiration après inactivité
LOGIN_MAX_ATTEMPTS=5           # comptes locaux : verrouillage après N échecs
LOGIN_LOCK_MINUTES=15

# --- Pièces jointes ---
UPLOAD_DIR=/var/lib/kanzen/uploads
UPLOAD_MAX_MB=20
# UPLOAD_ALLOWED_MIME=application/pdf,image/png,...   (liste par défaut dans src/server/config.js)

# --- Sources d'authentification ---
AUTH_LOCAL_ENABLED=true
AUTH_LDAP_ENABLED=false

# --- Active Directory (si AUTH_LDAP_ENABLED=true) ---
LDAP_URL=ldaps://dc1.corp.local:636,ldaps://dc2.corp.local:636
LDAP_BIND_DN=CN=svc-kanzen,OU=Comptes de service,DC=corp,DC=local
LDAP_BIND_PASSWORD=
LDAP_BASE_DN=DC=corp,DC=local
LDAP_GROUP_USERS=CN=GG_KanZen_Users,OU=Groupes,DC=corp,DC=local
LDAP_GROUP_ADMINS=CN=GG_KanZen_Admins,OU=Groupes,DC=corp,DC=local
LDAP_CA_FILE=/etc/pki/ca-trust/source/anchors/corp-root-ca.pem
# LDAP_USER_FILTER=(&(objectCategory=person)(objectClass=user)(sAMAccountName={{username}}))
# LDAP_STARTTLS=false
# LDAP_TIMEOUT_MS=5000
