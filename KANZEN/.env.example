# --- Configuration Serveur ---
NODE_ENV=production
PORT=3000
# Écoute en local uniquement : le reverse proxy (Caddy) expose le service.
# Mettre 0.0.0.0 dans un conteneur.
HOST=127.0.0.1

# --- Base de données (PostgreSQL) ---
DATABASE_URL="postgresql://kanzen:CHANGER_MOI@127.0.0.1:5432/kanzen?schema=public"

# --- Sécurité (JWT) ---
# Obligatoire, 32 caractères minimum : openssl rand -base64 48
JWT_SECRET=
