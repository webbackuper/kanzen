// KanZen v3 : modèle de données (PostgreSQL)
// Client Prisma 7 sans moteur binaire (driver adapter pg) : adapté au mode offline.

generator client {
  provider            = "prisma-client"
  output              = "../src/server/generated/prisma"
  moduleFormat        = "esm"
  // Imports en .js : le TypeScript généré est ensuite transpilé en JavaScript
  // (scripts/compile-prisma-client.js) pour tourner sur tout Node >= 22, y compris ceux des distributions.
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// Rôle global dans l'application
enum GlobalRole {
  ADMIN // administre l'instance (comptes, espaces, audit)
  USER
}

/// Rôle dans un espace de travail
enum WorkspaceRole {
  OWNER // gère l'espace et ses membres
  EDITOR // crée et modifie le contenu
  VIEWER // lecture seule
}

/// Priorité d'une tâche (de « aucune » à « critique »)
enum TaskPriority {
  NONE
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// Type d'un champ personnalisé de tableau
enum FieldType {
  TEXT
  NUMBER
  DATE
  SELECT
  CHECKBOX
}

/// Origine du compte
enum AuthSource {
  LOCAL
  LDAP
}

model User {
  id                 String     @id @default(uuid()) @db.Uuid
  /// Identifiant de connexion : sAMAccountName pour LDAP, libre pour LOCAL. Toujours en minuscules.
  username           String     @unique
  email              String?
  displayName        String
  authSource         AuthSource
  /// Hash argon2id, uniquement pour les comptes LOCAL
  passwordHash       String?
  /// objectGUID AD (stable même si le compte est renommé)
  externalId         String?    @unique
  role               GlobalRole @default(USER)
  disabled           Boolean    @default(false)
  /// Origine de la désactivation : « AD_SYNC » = retiré du groupe d'accès ou désactivé dans l'AD (réactivation
  /// automatique à son retour), null = décision d'un administrateur KanZen (jamais levée automatiquement)
  disabledReason     String?
  mustChangePassword Boolean    @default(false)
  failedLogins       Int        @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  sessions       Session[]
  memberships    WorkspaceMember[]
  assignments    TaskAssignee[]
  createdTasks   Task[]            @relation("CreatedBy")
  comments       Comment[]
  attachments    Attachment[]
  wikiCreated    WikiPage[]        @relation("WikiCreatedBy")
  wikiUpdated    WikiPage[]        @relation("WikiUpdatedBy")
  wikiRevisions  WikiRevision[]
  wikiFiles      WikiFile[]
  wikiAccess     WikiPageMember[]
  wikiFavorites  WikiFavorite[]
  wikiViews      WikiView[]
  wikiTaskLinks  WikiTaskLink[]
  taskActivities TaskActivity[]
  wikiComments   WikiComment[]     @relation("WikiCommentAuthor")
  wikiResolved   WikiComment[]     @relation("WikiCommentResolver")
  wikiVerified   WikiPage[]        @relation("WikiVerifiedBy")
  wikiOwned      WikiPage[]        @relation("WikiOwner")
  wikiTemplates  WikiTemplate[]
}

/// Session côté serveur : le cookie porte un jeton opaque, seul son SHA-256 est stocké.
model Session {
  id         String   @id @default(uuid()) @db.Uuid
  tokenHash  String   @unique
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime
  ip         String?
  userAgent  String?

  @@index([userId])
  @@index([expiresAt])
}

model Workspace {
  id             String            @id @default(uuid()) @db.Uuid
  name           String
  slug           String            @unique
  createdAt      DateTime          @default(now())
  members        WorkspaceMember[]
  boards         Board[]
  wikiPages      WikiPage[]
  wikiTemplates  WikiTemplate[]
  /// Page affichée en tête de l'accueil du wiki (facultative)
  wikiHomePageId String?           @unique @db.Uuid
  wikiHomePage   WikiPage?         @relation("WikiHome", fields: [wikiHomePageId], references: [id], onDelete: SetNull)
}

model WorkspaceMember {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @db.Uuid
  workspaceId String        @db.Uuid
  role        WorkspaceRole @default(EDITOR)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
}

model Board {
  id          String       @id @default(uuid()) @db.Uuid
  title       String
  workspaceId String       @db.Uuid
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  archived    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  columns     Column[]
  labels      Label[]
  fields      BoardField[]

  @@index([workspaceId])
}

/// Champ personnalisé d'un tableau (à la monday / ClickUp)
model BoardField {
  id       String           @id @default(uuid()) @db.Uuid
  boardId  String           @db.Uuid
  board    Board            @relation(fields: [boardId], references: [id], onDelete: Cascade)
  name     String
  type     FieldType
  /// Valeurs proposées (type SELECT)
  options  String[]         @default([])
  position Float
  values   TaskFieldValue[]

  @@index([boardId])
}

/// Valeur d'un champ personnalisé sur une carte (JSON typé selon le champ)
model TaskFieldValue {
  taskId  String     @db.Uuid
  task    Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fieldId String     @db.Uuid
  field   BoardField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  value   Json

  @@id([taskId, fieldId])
  @@index([fieldId])
}

/// Dépendance entre cartes : « blocker » bloque « blocked » (même espace)
model TaskDependency {
  blockerId   String   @db.Uuid
  blocker     Task     @relation("Blocks", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId   String   @db.Uuid
  blocked     Task     @relation("BlockedBy", fields: [blockedId], references: [id], onDelete: Cascade)
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

/// Étiquette d'un tableau (nom + couleur), à la Trello
model Label {
  id       String      @id @default(uuid()) @db.Uuid
  boardId  String      @db.Uuid
  board    Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  name     String
  color    String
  position Float
  tasks    TaskLabel[]

  @@index([boardId])
}

model TaskLabel {
  taskId  String @db.Uuid
  task    Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  labelId String @db.Uuid
  label   Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@index([labelId])
}

model Column {
  id       String @id @default(uuid()) @db.Uuid
  title    String
  position Float
  boardId  String @db.Uuid
  board    Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  /// Limite WIP optionnelle
  wipLimit Int?
  tasks    Task[]

  @@index([boardId])
}

model Task {
  id          String           @id @default(uuid()) @db.Uuid
  title       String
  description String           @default("")
  color       String           @default("white")
  /// Position fractionnaire dans la colonne (réordonnancement sans renuméroter)
  position    Float
  columnId    String           @db.Uuid
  column      Column           @relation(fields: [columnId], references: [id], onDelete: Cascade)
  dueDate     DateTime?
  startDate   DateTime?
  priority    TaskPriority     @default(NONE)
  /// Estimation de la charge, en heures
  estimate    Float?
  /// Carte archivée : masquée du tableau, restaurable
  archivedAt  DateTime?
  assignees   TaskAssignee[]
  labels      TaskLabel[]
  activities  TaskActivity[]
  fieldValues TaskFieldValue[]
  blocks      TaskDependency[] @relation("Blocks")
  blockedBy   TaskDependency[] @relation("BlockedBy")
  createdById String?          @db.Uuid
  createdBy   User?            @relation("CreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  subtasks    SubTask[]
  comments    Comment[]
  attachments Attachment[]
  events      TaskEvent[]
  wikiLinks   WikiTaskLink[]

  /// Chargement d'un tableau : cartes d'une colonne triées par position
  @@index([columnId, position])
  @@index([dueDate])
  @@index([archivedAt])
}

/// Journal d'activité d'une carte (création, déplacement, modification, commentaire…)
model TaskActivity {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @db.Uuid
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actorId   String?  @db.Uuid
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  /// create, update, move, archive, restore, comment, duplicate, transfer, attachment
  type      String
  data      Json?
  createdAt DateTime @default(now())

  @@index([taskId, createdAt])
}

/// Affectation d'une tâche à un ou plusieurs utilisateurs
model TaskAssignee {
  taskId     String   @db.Uuid
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@id([taskId, userId])
  @@index([userId])
}

model SubTask {
  id        String  @id @default(uuid()) @db.Uuid
  content   String
  completed Boolean @default(false)
  position  Float
  taskId    String  @db.Uuid
  task      Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model Attachment {
  id           String   @id @default(uuid()) @db.Uuid
  /// Nom d'origine, affiché uniquement (jamais utilisé comme chemin)
  filename     String
  /// Nom de stockage généré (UUID), sans lien avec le nom fourni
  storageName  String   @unique
  mimetype     String
  size         Int
  sha256       String
  taskId       String   @db.Uuid
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedById String?  @db.Uuid
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedAt   DateTime @default(now())

  @@index([taskId])
}

model Comment {
  id        String    @id @default(uuid()) @db.Uuid
  content   String
  createdAt DateTime  @default(now())
  /// Renseigné quand l'auteur a modifié son commentaire
  editedAt  DateTime?
  taskId    String    @db.Uuid
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String?   @db.Uuid
  author    User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
}

/// Historique des déplacements (alimente les statistiques)
model TaskEvent {
  id           String   @id @default(uuid()) @db.Uuid
  taskId       String   @db.Uuid
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fromColumnId String?  @db.Uuid
  toColumnId   String   @db.Uuid
  actorId      String?  @db.Uuid
  timestamp    DateTime @default(now())

  @@index([taskId])
  @@index([timestamp])
  /// Statistiques : arrivées dans une colonne sur une période
  @@index([toColumnId, timestamp])
}

/// Journal d'audit sécurité (connexions, administration). Aussi émis en JSON sur stdout (journald / SIEM).
model AuditLog {
  id        BigInt   @id @default(autoincrement())
  timestamp DateTime @default(now())
  actorId   String?  @db.Uuid
  actorName String?
  action    String
  target    String?
  outcome   String
  ip        String?
  details   Json?

  @@index([timestamp])
  @@index([action])
}

// ---------------------------------------------------------------------------
// Wiki : pages arborescentes par espace de travail, historique et recherche
// ---------------------------------------------------------------------------

/// Page du wiki. Le contenu est un document ProseMirror (JSON) validé côté serveur :
/// aucun HTML brut n'est stocké, ce qui ferme la porte au XSS stocké.
model WikiPage {
  id          String                   @id @default(uuid()) @db.Uuid
  workspaceId String                   @db.Uuid
  workspace   Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parentId    String?                  @db.Uuid
  parent      WikiPage?                @relation("WikiTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    WikiPage[]               @relation("WikiTree")
  title       String
  icon        String?
  content     Json
  /// Texte brut extrait du contenu (recherche, extraits)
  text        String                   @default("")
  /// Position fractionnaire parmi les pages sœurs
  position    Float
  /// Incrémentée à chaque enregistrement : détection des modifications concurrentes
  version     Int                      @default(1)
  createdById String?                  @db.Uuid
  createdBy   User?                    @relation("WikiCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?                  @db.Uuid
  updatedBy   User?                    @relation("WikiUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  /// Corbeille : renseigné quand la page (et sa descendance) est supprimée
  deletedAt   DateTime?
  /// Index plein texte : colonne GÉNÉRÉE par PostgreSQL (titre poids A, texte poids B, configuration « french »),
  /// définie dans la migration 20261125140000_wiki. Ne jamais l'écrire. Une future « migrate dev » proposera
  /// à tort un « DROP DEFAULT » sur cette colonne : retirer cette ligne du SQL généré.
  search      Unsupported("tsvector")?

  /// Accès restreint : la page et sa descendance ne sont visibles que des membres listés
  /// (et des propriétaires de l'espace). Les restrictions des ancêtres se cumulent.
  restricted Boolean @default(false)

  /// Page vérifiée (à la Confluence / Notion) : propriétaire, dernière vérification et périodicité de revue
  ownerId         String?   @db.Uuid
  owner           User?     @relation("WikiOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  verifiedAt      DateTime?
  verifiedById    String?   @db.Uuid
  verifiedBy      User?     @relation("WikiVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  reviewEveryDays Int?

  revisions WikiRevision[]
  files     WikiFile[]
  access    WikiPageMember[]
  favorites WikiFavorite[]
  views     WikiView[]
  taskLinks WikiTaskLink[]
  comments  WikiComment[]
  homeOf    Workspace?       @relation("WikiHome")

  @@index([workspaceId, parentId])
  @@index([parentId])
  @@index([workspaceId, deletedAt])
  @@index([search], type: Gin)
}

/// Historique : instantané d'une page après enregistrement
model WikiRevision {
  id        String   @id @default(uuid()) @db.Uuid
  pageId    String   @db.Uuid
  page      WikiPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  version   Int
  title     String
  content   Json
  authorId  String?  @db.Uuid
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([pageId, createdAt])
}

/// Image ou fichier inséré dans une page
model WikiFile {
  id           String   @id @default(uuid()) @db.Uuid
  pageId       String   @db.Uuid
  page         WikiPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  filename     String
  storageName  String   @unique
  mimetype     String
  size         Int
  sha256       String
  uploadedById String?  @db.Uuid
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedAt   DateTime @default(now())

  @@index([pageId])
}

/// Utilisateur autorisé sur une page à accès restreint
model WikiPageMember {
  pageId    String   @db.Uuid
  page      WikiPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([pageId, userId])
  @@index([userId])
}

/// Page mise en favori par un utilisateur
model WikiFavorite {
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pageId    String   @db.Uuid
  page      WikiPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, pageId])
  @@index([pageId])
}

/// Dernière consultation d'une page par un utilisateur (pages récentes)
model WikiView {
  userId   String   @db.Uuid
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pageId   String   @db.Uuid
  page     WikiPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  viewedAt DateTime @default(now())

  @@id([userId, pageId])
  @@index([userId, viewedAt])
  @@index([pageId])
}

/// Lien entre une page du wiki et une tâche du Kanban (même espace)
model WikiTaskLink {
  pageId      String   @db.Uuid
  page        WikiPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  taskId      String   @db.Uuid
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdById String?  @db.Uuid
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@id([pageId, taskId])
  @@index([taskId])
}

/// Commentaire sur une page du wiki (fil de discussion à un niveau, résolvable)
model WikiComment {
  id           String        @id @default(uuid()) @db.Uuid
  pageId       String        @db.Uuid
  page         WikiPage      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  parentId     String?       @db.Uuid
  parent       WikiComment?  @relation("WikiCommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies      WikiComment[] @relation("WikiCommentThread")
  authorId     String?       @db.Uuid
  author       User?         @relation("WikiCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  content      String
  createdAt    DateTime      @default(now())
  editedAt     DateTime?
  resolvedAt   DateTime?
  resolvedById String?       @db.Uuid
  resolvedBy   User?         @relation("WikiCommentResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([pageId, createdAt])
  @@index([parentId])
}

/// Modèle de page créé par l'équipe (en plus des modèles fournis)
model WikiTemplate {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title       String
  icon        String?
  description String    @default("")
  content     Json
  createdById String?   @db.Uuid
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId])
}
