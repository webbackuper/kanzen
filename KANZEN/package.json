{
  "name": "kanzen",
  "version": "3.0.0-dev",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:ui\"",
    "dev:server": "NODE_ENV=development node --watch src/server/index.js",
    "dev:ui": "vite src/client",
    "build": "npm run build:ui",
    "build:ui": "vite build src/client",
    "start": "node src/server/index.js",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "prisma generate && node scripts/compile-prisma-client.js",
    "db:migrate": "prisma migrate deploy",
    "prisma:seed": "node prisma/seed.js",
    "sbom": "npm sbom --sbom-format cyclonedx --omit=dev > sbom.cdx.json",
    "test:e2e": "node test/e2e/smoke.mjs",
    "admin:create": "node scripts/create-admin.js",
    "postinstall": "npm run db:generate"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.9",
    "@fastify/rate-limit": "^11.3.0",
    "@fastify/static": "^10.1.12",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@tiptap/extension-highlight": "^3.35.0",
    "@tiptap/extension-image": "^3.35.0",
    "@tiptap/extension-list": "^3.35.0",
    "@tiptap/extension-table": "^3.35.0",
    "@tiptap/extensions": "^3.35.0",
    "@tiptap/pm": "^3.35.0",
    "@tiptap/react": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0",
    "argon2": "^0.45.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "fastify": "^5.12.8",
    "json2csv": "^5.0.7",
    "ldapts": "^9.3.6",
    "lucide-react": "^1.80.0",
    "pg": "^8.16.3",
    "prisma": "^7.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.7",
    "recharts": "^3.11.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.14.0",
    "playwright": "^1.63.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "overrides": {
    "effect": "^3.22.5"
  }
}
