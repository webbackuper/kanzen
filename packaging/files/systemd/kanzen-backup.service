[Unit]
Description=Sauvegarde KanZen (PostgreSQL + pièces jointes)
After=postgresql.service

[Service]
Type=oneshot
User=kanzen
Group=kanzen
EnvironmentFile=/etc/kanzen/kanzen.env
Environment=BACKUP_DIR=/var/backups/kanzen
ExecStart=/opt/kanzen/app/scripts/backup.sh
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/backups/kanzen
ReadOnlyPaths=/var/lib/kanzen /etc/kanzen
UMask=0077
