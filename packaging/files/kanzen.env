# ===== KanZen : configuration de production =====
# Fichier lu par systemd (EnvironmentFile). Droits : root:kanzen 0640.
# Après modification : systemctl restart kanzen
# Tout secret XXX peut être placé dans un fichier séparé via XXX_FILE=/etc/kanzen/secrets/xxx

# --- Serveur ---
HOST=127.0.0.1
PORT=3000
PUBLIC_URL=https://kanzen.corp.local
TRUST_PROXY=127.0.0.1
STATIC_DIR=/opt/kanzen/app/public
LOG_LEVEL=info

# --- Base de données ---
# Recommandé : chaîne dans un fichier secret (root:kanzen 0640) plutôt qu'ici
# DATABASE_URL_FILE=/etc/kanzen/secrets/database_url
DATABASE_URL=postgresql://kanzen:CHANGER_MOI@127.0.0.1:5432/kanzen?schema=public

# --- Sessions ---
SESSION_TTL_HOURS=8
SESSION_IDLE_MINUTES=60
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# --- Pièces jointes ---
UPLOAD_DIR=/var/lib/kanzen/uploads
UPLOAD_MAX_MB=20

# --- Sauvegardes (kanzen-backup.timer) ---
BACKUP_RETENTION_DAYS=14
# Chiffrement des archives : clé PUBLIQUE importée dans /etc/kanzen/gnupg (voir plan de déploiement)
# BACKUP_GPG_RECIPIENT=sauvegardes@corp.local
# BACKUP_GNUPGHOME=/etc/kanzen/gnupg

# --- Sources d'authentification ---
AUTH_LOCAL_ENABLED=true
AUTH_LDAP_ENABLED=false

# --- Active Directory ---
LDAP_URL=ldaps://dc1.corp.local:636,ldaps://dc2.corp.local:636
LDAP_BIND_DN=CN=svc-kanzen,OU=Comptes de service,DC=corp,DC=local
LDAP_BIND_PASSWORD_FILE=/etc/kanzen/secrets/ldap_bind_password
LDAP_BASE_DN=DC=corp,DC=local
LDAP_GROUP_USERS=CN=GG_KanZen_Users,OU=Groupes,DC=corp,DC=local
LDAP_GROUP_ADMINS=CN=GG_KanZen_Admins,OU=Groupes,DC=corp,DC=local
LDAP_CA_FILE=/etc/kanzen/ca/corp-ca.pem
# Synchronisation des départs : un compte retiré de LDAP_GROUP_USERS, désactivé ou supprimé dans l'AD est
# désactivé dans KanZen et ses sessions sont révoquées. Période en minutes (0 = désactivée).
AD_SYNC_INTERVAL_MINUTES=15

# --- Retours utilisateurs ---
# Bouton « Suggérer / signaler » : UUID du tableau qui reçoit les retours (adresse /b/<uuid>). Vide = bouton masqué.
# FEEDBACK_BOARD_ID=
